<!-- Configuración del proyecto home:nachopro en build.opensuse.org.
     Se aplica una sola vez con: osc meta prj home:nachopro -F packaging/obs/project.xml
     Los nombres de repositorio son los que después aparecen en download.opensuse.org. -->
<project name="home:nachopro">
  <title>Trigonum</title>
  <description>Packages for Trigonum, a lightweight viewer for STL 3D models. Source: https://git.local.net.ar/nachopro/trigonum</description>
  <person userid="nachopro" role="maintainer"/>
  <repository name="Debian_13">
    <path project="Debian:13" repository="update"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
  <repository name="xUbuntu_26.04">
    <path project="Ubuntu:26.04" repository="universe"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
  <repository name="Fedora_45">
    <path project="Fedora:45" repository="update"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
  <repository name="Fedora_44">
    <path project="Fedora:44" repository="update"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
  <repository name="openSUSE_Tumbleweed">
    <path project="openSUSE:Factory" repository="snapshot"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
</project>

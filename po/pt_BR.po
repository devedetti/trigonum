#: src/window.rs:289
msgid ""
"Left button + drag: orbit\n"
"Middle or right button + drag: pan\n"
"Shift + left button + drag: pan\n"
"Scroll wheel: zoom\n"
"Double click: fit model"
msgstr ""
"Botão esquerdo + arrastar: orbitar\n"
"Botão do meio ou direito + arrastar: deslocar\n"
"Shift + botão esquerdo + arrastar: deslocar\n"
"Roda do mouse: zoom\n"
"Clique duplo: enquadrar o modelo"


#: data/trigonum.desktop.in.in:3 data/trigonum.metainfo.xml.in.in:8
msgid "Trigonum"
msgstr ""

#: data/trigonum.desktop.in.in:4
msgid "3D Model Viewer"
msgstr "Visualizador de modelos 3D"

#: data/trigonum.desktop.in.in:5 data/trigonum.metainfo.xml.in.in:9
msgid "View STL 3D models"
msgstr "Visualize modelos 3D no formato STL"

#. TRANSLATORS: search terms, separated by semicolons. Keep the English ones and the final semicolon.
#: data/trigonum.desktop.in.in:7
msgid "3D;STL;model;mesh;printing;CAD;"
msgstr "3D;STL;model;mesh;printing;CAD;modelo;malha;impressão;"

#: data/trigonum.metainfo.xml.in.in:15
msgid ""
"Trigonum is a fast, lightweight viewer for STL files, the format used for 3D "
"printing and for exporting models from CAD programs."
msgstr ""
"Trigonum é um visualizador rápido e leve para arquivos STL, o formato usado "
"em impressão 3D e para exportar modelos de programas CAD."

#: data/trigonum.metainfo.xml.in.in:20
msgid "Opens binary and ASCII STL files, even with millions of triangles"
msgstr "Abre arquivos STL binários e ASCII, mesmo com milhões de triângulos"

#: data/trigonum.metainfo.xml.in.in:21
msgid "Shows dimensions, triangle count, volume and surface area"
msgstr "Mostra dimensões, número de triângulos, volume e área de superfície"

#: data/trigonum.metainfo.xml.in.in:22
msgid "Tabs to keep several models open at once"
msgstr "Abas para manter vários modelos abertos ao mesmo tempo"

#: data/trigonum.metainfo.xml.in.in:23
msgid "Optional wireframe overlay"
msgstr "Sobreposição opcional de malha aramada"

#: data/trigonum.metainfo.xml.in.in:24
msgid "Reloads the model automatically when the file changes on disk"
msgstr "Recarrega o modelo automaticamente quando o arquivo muda no disco"

#: data/trigonum.metainfo.xml.in.in:25
msgid "Classic interface with menu bar, toolbar and status bar"
msgstr ""
"Interface clássica com barra de menus, barra de ferramentas e barra de status"

#: data/trigonum.metainfo.xml.in.in:53
msgid "Fixed a crash on startup."
msgstr "Corrigido um travamento ao iniciar."

#: data/trigonum.metainfo.xml.in.in:58
msgid "First release."
msgstr "Primeira versão."


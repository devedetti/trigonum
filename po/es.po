#: data/trigonum.desktop.in.in:3 data/trigonum.metainfo.xml.in.in:8
msgid "Trigonum"
msgstr ""

#: data/trigonum.desktop.in.in:4
msgid "3D Model Viewer"
msgstr "Visor de modelos 3D"

#: data/trigonum.desktop.in.in:5 data/trigonum.metainfo.xml.in.in:9
msgid "View STL 3D models"
msgstr "Ver modelos 3D en formato STL"

#. TRANSLATORS: search terms, separated by semicolons. Keep the English ones and the final semicolon.
#: data/trigonum.desktop.in.in:7
msgid "3D;STL;model;mesh;printing;CAD;"
msgstr "3D;STL;model;mesh;printing;CAD;modelo;malla;impresión;"

#: data/trigonum.metainfo.xml.in.in:15
msgid "Trigonum is a fast, lightweight viewer for STL files, the format used for 3D printing and for exporting models from CAD programs."
msgstr "Trigonum es un visor rápido y ligero para archivos STL, el formato que se usa en impresión 3D y para exportar modelos desde programas de CAD."

#: data/trigonum.metainfo.xml.in.in:20
msgid "Opens binary and ASCII STL files, even with millions of triangles"
msgstr "Abre archivos STL binarios y ASCII, incluso con millones de triángulos"

#: data/trigonum.metainfo.xml.in.in:21
msgid "Shows dimensions, triangle count, volume and surface area"
msgstr "Muestra dimensiones, cantidad de triángulos, volumen y superficie"

#: data/trigonum.metainfo.xml.in.in:22
msgid "Optional wireframe overlay"
msgstr "Malla de alambre superpuesta opcional"

#: data/trigonum.metainfo.xml.in.in:23
msgid "Reloads the model automatically when the file changes on disk"
msgstr "Recarga el modelo automáticamente cuando el archivo cambia en el disco"

#: data/trigonum.metainfo.xml.in.in:24
msgid "Classic interface with menu bar, toolbar and status bar"
msgstr "Interfaz clásica con barra de menús, barra de herramientas y barra de estado"

#: data/trigonum.metainfo.xml.in.in:49
msgid "Fixed a crash on startup."
msgstr "Se corrigió un cierre inesperado al iniciar."

#: data/trigonum.metainfo.xml.in.in:54
msgid "First release."
msgstr "Primera versión."

